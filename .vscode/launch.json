{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "seedAdminPassword",
            "type": "promptString",
            "description": "Initial admin password: 6-48 characters, including a letter and a digit; leave blank if already created. Admin1234 is not allowed.",
            "password": true
        }
    ],
    "configurations": [
        {
            "name": "Debug server (debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/oatpp-backend",
            "args": [
                "--config",
                "${workspaceFolder}/configs/app.conf"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "environment": [{ "name": "APP_SEED_ADMIN_PASSWORD", "value": "${input:seedAdminPassword}" }],
            "preLaunchTask": "Preset: Build (debug)"
        },
        {
            "name": "Debug tests (debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/app_tests",
