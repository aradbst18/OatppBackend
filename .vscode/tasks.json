{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format: C/C++ (clang-format)",
            "type": "shell",
            "command": "find src include tests -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cc' -o -name '*.hh' -o -name '*.cpp' -o -name '*.hpp' -o -name '*.cxx' -o -name '*.hxx' \\) -exec clang-format --style=file -i {} +",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${userHome}/.local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "detail": "Format all C/C++ sources and headers in src, include, and tests using .clang-format."
        },
        {
            "label": "Format: CMake (cmake-format)",
            "type": "shell",
            "command": "cmake-format -i CMakeLists.txt cmake/*.cmake tests/CMakeLists.txt",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${userHome}/.local/bin:${env:PATH}"
                }
            },
            "problemMatcher": [],
            "detail": "Format CMakeLists.txt, cmake/*.cmake and tests/CMakeLists.txt using .cmake-format.yaml."
        },
        {
            "label": "Format: All",
            "type": "shell",
            "command": "echo 'Use Ctrl+Shift+B / Run Task to run Format: C/C++ and Format: CMake'",
            "dependsOn": [
                "Format: C/C++ (clang-format)",
                "Format: CMake (cmake-format)"
            ],
            "problemMatcher": [],
            "detail": "Run every formatter (C/C++ + CMake) for the whole project."
        },
