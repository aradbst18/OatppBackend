# Build summary printed at configure time. Every project setting that can be changed via a variable or option is echoed below; per-dependency paths,
# versions and static/shared link types only print when VERBOSE_BUILD_SUMMARY=ON (base preset cacheVariables).

# One "label : value" row. Labels are padded to a fixed width so every ':' lands in a single column (longest label is CMAKE_EXPORT_COMPILE_COMMANDS).
function(app_summary_row label value)
    set(_width 29)
    string(LENGTH "${label}" _len)
    set(_padded "${label}")

    while(_len LESS _width)
        string(APPEND _padded " ")
        math(EXPR _len "${_len} + 1")
    endwhile()

    message(STATUS "  ${_padded} : ${value}")
endfunction()

# Boolean flag value as emoji: ✅ when truthy, ❌ otherwise.
function(app_flag_emoji var out)
    if(${var})
        set(${out}
            "✅"
            PARENT_SCOPE)
    else()
        set(${out}
            "❌"
            PARENT_SCOPE)
    endif()
endfunction()

# Report one dependency target: type, resolved file (static .a vs shared .so) and version when the find module provides one.
function(app_describe_target tgt)
    if(NOT TARGET ${tgt})
        app_summary_row("${tgt}" "<not in this build>")
        return()
    endif()

    get_target_property(tgt_type ${tgt} TYPE)

    set(loc "")
    foreach(prop IMPORTED_LOCATION IMPORTED_LOCATION_${CMAKE_BUILD_TYPE} IMPORTED_LOCATION_NOCONFIG IMPORTED_LOCATION_NONE IMPORTED_LOCATION_RELEASE
                 IMPORTED_LOCATION_DEBUG)
        get_target_property(prop_val ${tgt} ${prop})
        if(prop_val AND NOT prop_val MATCHES "-NOTFOUND$")
            set(loc "${prop_val}")
            break()
        endif()
    endforeach()

    set(link "unknown")
    if(tgt_type MATCHES "STATIC")
        set(link "static")
    elseif(tgt_type MATCHES "SHARED")
        set(link "shared")
    elseif(tgt_type STREQUAL "INTERFACE_LIBRARY")
        set(link "interface")
    elseif(loc MATCHES "\\.a$")
        set(link "static")
    elseif(loc MATCHES "\\.so(\\.|$)")
        set(link "shared")
    endif()

    if(loc STREQUAL "")
        if(tgt_type STREQUAL "INTERFACE_LIBRARY")
            get_target_property(iface_libs ${tgt} INTERFACE_LINK_LIBRARIES)
            if(iface_libs AND NOT iface_libs MATCHES "-NOTFOUND$")
                set(loc "flags: ${iface_libs}")
            else()
                set(loc "header-only")
            endif()
        else()
            set(loc "unresolved at configure time")
        endif()
    endif()

    app_target_version(${tgt} ver)
    app_summary_row("${tgt}" "link=${link} version=${ver} path=${loc}")
endfunction()

# Total number of .cpp files actually compiled into the given targets. Uses TARGET SOURCES so conditionally-added files (SQLCIPHER backend, optional
# parsers, swagger) are only counted when enabled, unlike a filesystem GLOB.
function(app_source_file_count out_var)
    set(_all_sources "")
    foreach(_tgt IN LISTS ARGN)
        if(TARGET ${_tgt})
            get_target_property(_srcs ${_tgt} SOURCES)
            if(_srcs AND NOT _srcs MATCHES "-NOTFOUND$")
                list(APPEND _all_sources ${_srcs})
            endif()
        endif()
    endforeach()

    list(LENGTH _all_sources _n)
    set(${out_var}
        "${_n}"
        PARENT_SCOPE)
endfunction()

# Best-effort version lookup: first defined candidate variable wins.
function(app_target_version tgt out)
    set(candidates "")
    if(tgt MATCHES "^oatpp::")
        set(candidates oatpp_VERSION OATPP_VERSION)
    elseif(tgt STREQUAL "jsoncpp_static")
        set(candidates jsoncpp_VERSION JsonCpp_VERSION)
    elseif(tgt STREQUAL "toml11::toml11")
        set(candidates toml11_VERSION TOML11_VERSION)
    elseif(tgt STREQUAL "pugixml::static")
        set(candidates pugixml_VERSION PUGIXML_VERSION)
    elseif(tgt STREQUAL "yaml-cpp::yaml-cpp")
        set(candidates yaml-cpp_VERSION YAML_CPP_VERSION)
    elseif(tgt STREQUAL "jwt-cpp::jwt-cpp")
        set(candidates jwt-cpp_VERSION JWT_CPP_VERSION)
    elseif(tgt MATCHES "^OpenSSL::")
        set(candidates OPENSSL_VERSION)
    elseif(tgt STREQUAL "ZLIB::ZLIB")
        set(candidates ZLIB_VERSION_STRING)
    elseif(tgt STREQUAL "SQLite::SQLite3")
        set(candidates SQLite3_VERSION SQLITE3_VERSION)
    elseif(tgt STREQUAL "PkgConfig::SQLCIPHER")
        set(candidates SQLCIPHER_VERSION)
    elseif(tgt STREQUAL "ZSTD::ZSTD")
        set(candidates ZSTD_VERSION)
    endif()

    set(ver "unknown")
    foreach(var IN LISTS candidates)
        if(DEFINED ${var})
            set(ver "${${var}}")
            break()
        endif()
    endforeach()

    set(${out}
        "${ver}"
        PARENT_SCOPE)
endfunction()

function(print_build_summary)
    message(STATUS "OatppBackend ${PROJECT_VERSION} summary:")
    app_summary_row("CMAKE_CXX_STANDARD" "${CMAKE_CXX_STANDARD}")
    app_summary_row("CMAKE_BUILD_TYPE" "${CMAKE_BUILD_TYPE}")
    app_summary_row("CMAKE_GENERATOR" "${CMAKE_GENERATOR}")
    app_flag_emoji(CMAKE_EXPORT_COMPILE_COMMANDS _v)
    app_summary_row("CMAKE_EXPORT_COMPILE_COMMANDS" "${_v}")
    app_summary_row("CMAKE_INSTALL_PREFIX" "${CMAKE_INSTALL_PREFIX}")
    app_flag_emoji(APP_BUILD_TESTS _v)
    app_summary_row("APP_BUILD_TESTS" "${_v}")
    app_flag_emoji(APP_ENABLE_ZLIB _v)
    app_summary_row("APP_ENABLE_ZLIB" "${_v}")
    app_flag_emoji(APP_ENABLE_SWAGGER _v)
    app_summary_row("APP_ENABLE_SWAGGER" "${_v}")
    app_flag_emoji(ENABLE_SANITIZERS _v)
    app_summary_row("ENABLE_SANITIZERS" "${_v} (master switch)")

    # Effective set comes from the single source of truth in cmake/sanitizers.cmake (option + build type + compiler), never from the raw switch alone.
    # Release/MinSizeRel report None by policy even when the switch is ON.
    app_sanitizers_label(_sani_label)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _bt_upper)
    if(ENABLE_SANITIZERS AND (_bt_upper STREQUAL "RELEASE" OR _bt_upper STREQUAL "MINSIZEREL"))
        app_summary_row("Sanitizers" "${_sani_label} (disabled by policy for Release/MinSizeRel)")
    else()
        app_summary_row("Sanitizers" "${_sani_label}")
    endif()

    app_flag_emoji(APP_ENABLE_JSON_PARSER _v)
    app_summary_row("APP_ENABLE_JSON_PARSER" "${_v}")
    app_flag_emoji(APP_ENABLE_TOML_PARSER _v)
    app_summary_row("APP_ENABLE_TOML_PARSER" "${_v}")
    app_flag_emoji(APP_ENABLE_XML_PARSER _v)
    app_summary_row("APP_ENABLE_XML_PARSER" "${_v}")
    app_flag_emoji(APP_ENABLE_YAML_PARSER _v)
    app_summary_row("APP_ENABLE_YAML_PARSER" "${_v}")
    app_summary_row("APP_DATABASE_BACKEND" "${APP_DATABASE_BACKEND}")
    app_summary_row("APP_PASSWORD_HASH_ALGO" "${APP_PASSWORD_HASH_ALGO}")
    app_summary_row("APP_CONFIG_FORMAT" "${APP_CONFIG_FORMAT}")
    app_summary_row("APP_VERSION" "${PROJECT_VERSION}")
    app_summary_row("APP_RELEASE_DATE" "${APP_RELEASE_DATE}")
    app_summary_row("APP_VERSION_FILE_FORMAT" "${APP_VERSION_FILE_FORMAT}")
    app_source_file_count(_num_sources app_core app_server app_tests)
    app_summary_row("APP_SOURCE_FILES" "${_num_sources}")
    app_flag_emoji(VERBOSE_BUILD_SUMMARY _v)
    app_summary_row("VERBOSE_BUILD_SUMMARY" "${_v}")

    if(VERBOSE_BUILD_SUMMARY)
        app_summary_row("CMAKE_FIND_LIBRARY_SUFFIXES" "${CMAKE_FIND_LIBRARY_SUFFIXES}")
        message(STATUS "  dependencies:")
        app_describe_target(oatpp::oatpp)
        app_describe_target(oatpp::oatpp-sqlite)
        app_describe_target(oatpp::oatpp-websocket)
        app_describe_target(oatpp::oatpp-zlib)
        app_describe_target(oatpp::oatpp-swagger)
        app_describe_target(jsoncpp_static)
        app_describe_target(toml11::toml11)
        app_describe_target(pugixml::static)
        app_describe_target(yaml-cpp::yaml-cpp)
        app_describe_target(jwt-cpp::jwt-cpp)
        app_describe_target(OpenSSL::SSL)
        app_describe_target(OpenSSL::Crypto)
        app_describe_target(ZLIB::ZLIB)
        app_describe_target(SQLite::SQLite3)
        app_describe_target(PkgConfig::SQLCIPHER)
        app_describe_target(ZSTD::ZSTD)
    endif()
endfunction()
