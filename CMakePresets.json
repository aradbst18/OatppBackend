{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/${presetName}/out",
                "APP_ENABLE_ZLIB": true,
                "APP_PASSWORD_HASH_ALGO": "SHA512",
                "APP_ENABLE_POSTGRESQL": true,
                "APP_ENABLE_SQLCIPHER": true,
                "APP_USERS_DATABASE_TYPE": "SQLCIPHER",
                "APP_ENCRYPTION_USER_DATABASE": true,
                "APP_ENABLE_JSON_PARSER": true,
                "APP_ENABLE_TOML_PARSER": true,
                "APP_ENABLE_XML_PARSER": true,
                "APP_ENABLE_YAML_PARSER": true,
                "APP_CONFIG_FORMAT": "TOML",
                "APP_VERSION": "0.0.1",
                "APP_RELEASE_DATE": "",
                "APP_VERSION_FILE_FORMAT": "JSON",
                "VERBOSE_BUILD_SUMMARY": true
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (no sanitizers)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": false
            }
        },
        {
            "name": "debug-asan-ubsan",
            "displayName": "Debug + ASan/UBSan (largest)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "debug-tsan",
            "displayName": "Debug + ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "DebugTSan",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "debug-msan",
            "displayName": "Debug + MemorySanitizer (Clang only)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "DebugMSan",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (no sanitizers)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": false
            }
        },
        {
            "name": "relwithdebinfo-asan-ubsan",
            "displayName": "RelWithDebInfo + ASan/UBSan",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "relwithdebinfo-tsan",
            "displayName": "RelWithDebInfo + ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfoTSan",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "relwithdebinfo-msan",
            "displayName": "RelWithDebInfo + MemorySanitizer (Clang only)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfoMSan",
                "APP_BUILD_TESTS": true,
                "APP_ENABLE_SWAGGER": true,
                "ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "release",
            "displayName": "Release, sanitizers disabled by policy (balanced)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "APP_BUILD_TESTS": false,
                "APP_ENABLE_SWAGGER": false,
                "ENABLE_SANITIZERS": false
            }
        },
        {
            "name": "minsizerel",
            "displayName": "MinSizeRel, sanitizers disabled by policy (smallest)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "APP_BUILD_TESTS": false,
                "APP_ENABLE_SWAGGER": false,
                "ENABLE_SANITIZERS": false
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Build: Debug",
            "configurePreset": "debug",
            "jobs": 2
        },
        {
            "name": "debug-asan-ubsan",
            "displayName": "Build: Debug + ASan/UBSan",
            "configurePreset": "debug-asan-ubsan",
            "jobs": 2
        },
        {
            "name": "debug-tsan",
            "displayName": "Build: DebugTSan",
            "configurePreset": "debug-tsan",
            "jobs": 2
        },
        {
            "name": "debug-msan",
            "displayName": "Build: DebugMSan",
            "configurePreset": "debug-msan",
            "jobs": 2
        },
        {
            "name": "relwithdebinfo",
            "displayName": "Build: RelWithDebInfo",
            "configurePreset": "relwithdebinfo",
            "jobs": 2
        },
        {
            "name": "relwithdebinfo-asan-ubsan",
            "displayName": "Build: RelWithDebInfo + ASan/UBSan",
            "configurePreset": "relwithdebinfo-asan-ubsan",
            "jobs": 2
        },
        {
            "name": "relwithdebinfo-tsan",
            "displayName": "Build: RelWithDebInfoTSan",
            "configurePreset": "relwithdebinfo-tsan",
            "jobs": 2
        },
        {
            "name": "relwithdebinfo-msan",
            "displayName": "Build: RelWithDebInfoMSan",
            "configurePreset": "relwithdebinfo-msan",
            "jobs": 2
        },
        {
            "name": "release",
            "displayName": "Build: Release",
            "configurePreset": "release",
            "jobs": 2
        },
        {
            "name": "minsizerel",
            "displayName": "Build: MinSizeRel",
            "configurePreset": "minsizerel",
            "jobs": 2
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "displayName": "Test: Debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug-asan-ubsan",
            "displayName": "Test: Debug + ASan/UBSan",
            "configurePreset": "debug-asan-ubsan",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug-tsan",
            "displayName": "Test: DebugTSan",
